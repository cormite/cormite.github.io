{
  "prerender": [
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/assets/*" } },
          { "not": { "href_matches": "/*.pdf" } },
          { "not": { "selector_matches": "[rel~=nofollow], [download]" } }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
