    },
    "micromatch": {
      "picomatch": "^2.3.2"
    },
    "tinyglobby": {
      "picomatch": "^4.0.4"
    },
    "fdir": {
      "picomatch": "^4.0.4"
    }
  },
  "devDependencies": {
    "jsdom": "^29.0.2",
    "playwright": "^1.58.2",
    "tailwindcss": "^3.4.17"
  }
}
