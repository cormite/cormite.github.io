{
  "name": "cormite-github-io",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i ./assets/css/tailwind.input.css -o ./assets/css/tailwind.css --minify && node ./scripts/postbuild-css.mjs",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i ./assets/css/tailwind.input.css -o ./assets/css/tailwind.css --watch",
    "build:pages": "node ./scripts/build-static-pages.mjs",
    "build": "npm run build:css && npm run build:pages",
    "serve": "node scripts/serve.mjs",
    "test": "playwright test",
    "test:local": "PW_CHANNEL=chrome playwright test",
    "build:images": "node ./scripts/build-images.mjs",
    "build:social": "node ./scripts/build-social-card.mjs",
    "build:icons": "node ./scripts/build-icons.mjs"
  },
  "overrides": {
    "anymatch": {
      "picomatch": "^2.3.2"
    },
    "readdirp": {
      "picomatch": "^2.3.2"
    },
    "micromatch": {
      "picomatch": "^2.3.2"
    },
    "tinyglobby": {
      "picomatch": "^4.0.4"
    },
    "fdir": {
      "picomatch": "^4.0.4"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17"
  },
  "type": "commonjs"
}
